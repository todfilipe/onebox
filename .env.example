# OneBox · Variáveis de ambiente
#
# Copia este ficheiro para .env.local e preenche os valores reais.
# O .env.local é ignorado pelo Git; nunca committar valores reais.

# ── Google Cloud · OAuth ──────────────────────────────────────────────
# Criados em APIs & Services · Credentials, tipo "OAuth client ID" (Web).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Auth.js / NextAuth ────────────────────────────────────────────────
# Gerar o segredo com: openssl rand -base64 32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# URL base da aplicação; http://localhost:3000 em desenvolvimento,
# o domínio público em produção
NEXTAUTH_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────
# Valores no dashboard do projeto, em Settings · API.
SUPABASE_URL=https://your-project-ref.supabase.co
# Chave pública (anon); pode ser exposta ao browser
SUPABASE_ANON_KEY=your-supabase-anon-key
# Chave de service role; usar APENAS no servidor, nunca no cliente
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Segredo JWT do projeto (Settings · API · JWT Settings). A app assina com
# ele os tokens de curta duração que o browser usa no Realtime, com o id do
# utilizador em sub, para as políticas RLS o reconhecerem.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Supabase · migrations ─────────────────────────────────────────────
# Connection string da base de dados (botão Connect · Session pooler no
# dashboard). Usada apenas por ferramentas locais para aplicar migrations;
# nunca pelo código da aplicação.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
# Access token pessoal (dashboard · Account · Access Tokens), usado pelo
# npm run gen:types para gerar os tipos TypeScript sem precisar de Docker.
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# ── Google Gemini ─────────────────────────────────────────────────────
# Criada em https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ── Segurança ─────────────────────────────────────────────────────────
# Chave para encriptar os tokens OAuth em repouso na base de dados.
# Gerar com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# ── Gmail Pub/Sub ─────────────────────────────────────────────────────
# Nome completo do tópico, partilhado por todas as contas ligadas,
# no formato projects/NOME-DO-PROJETO/topics/NOME-DO-TOPICO
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/your-topic
