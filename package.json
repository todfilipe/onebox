{
  "name": "onebox",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:supabase": "node scripts/check-supabase.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:readme-assets": "node scripts/readme-assets.mjs",
    "db:push": "node scripts/db-push.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.4",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.4",
    "nanoid": "^3.3.18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
